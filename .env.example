# Optional Caddy site address. Keep :80 for IP/LAN mode; set a domain only when HTTPS is configured.
CLOUDLICENSE_SITE_ADDRESS=:80
CLOUDLICENSE_PUBLIC_ORIGIN=http://localhost:5173

# Replace every value below before a manual deployment. deploy/deploy.sh generates them automatically.
CLOUDLICENSE_ADMIN_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
CLOUDLICENSE_LICENSE_PEPPER=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_VALUE
CLOUDLICENSE_DB_PASSWORD=CHANGE_ME_GENERATE_A_DATABASE_PASSWORD

CLOUDLICENSE_DB_NAME=cloudlicense
CLOUDLICENSE_DB_USER=cloudlicense
CLOUDLICENSE_VERIFY_RATE_LIMIT=120
CLOUDLICENSE_TRUST_FORWARDED_FOR=false

# LAN defaults: 0.0.0.0:2345 -> 8080/tcp and 0.0.0.0:5173 -> 80/tcp.
CLOUDLICENSE_API_PORT=2345
CLOUDLICENSE_WEB_HTTP_PORT=5173
CLOUDLICENSE_WEB_HTTPS_PORT=5443
